# Copy to .env locally. Never commit .env.
# Generate each secret independently with a password manager, at least 32 random bytes.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=

# These defaults are for isolated localhost staging only.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_PROXY_HOPS=0
N8N_SECURE_COOKIE=false
# Before an HTTPS cutover, use the actual public hostname/URLs,
# N8N_PROTOCOL=https, N8N_SECURE_COOKIE=true, and the actual trusted proxy count.
# Google, Gemini and Discord secrets belong in n8n Credentials, not this file.

